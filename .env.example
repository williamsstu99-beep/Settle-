# Copy to .env.local and fill in. Never commit .env.local.

# Google Maps Platform (https://console.cloud.google.com/google/maps-apis)
# Browser key: Maps JavaScript API + Places API (New). Restrict it to your site's domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key: Routes API. Restrict it to the Routes API. Never exposed to the browser.
GOOGLE_MAPS_SERVER_KEY=
# Optional: a cloud Map ID if you style the map in Google Cloud instead of the built-in style.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# TradeMe API (optional: enables "paste a TradeMe link")
TRADEME_CONSUMER_KEY=
TRADEME_CONSUMER_SECRET=
# sandbox while building, production once TradeMe approves your app
TRADEME_ENV=sandbox
